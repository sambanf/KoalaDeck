<UserControl x:Class="KoalaDeck.Controls.AddAppButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KoalaDeck.ViewModels"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Exe / shortcut icon when known, generic app glyph otherwise -->
        <DataTemplate x:Key="AppIconTemplate">
            <Grid Width="20" Height="20">
                <Path x:Name="Fallback" Data="{StaticResource IconApp}" Fill="{StaticResource TextDimBrush}"
                      Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed" />
                <Image x:Name="Picture" Source="{Binding}" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter TargetName="Fallback" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Picture" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AppItemTemplate" DataType="{x:Type vm:AudioAppItem}">
            <Button Style="{StaticResource AppItemButton}" Click="Item_Click" Padding="10,5"
                    AutomationProperties.Name="{Binding Name}" ToolTip="{Binding ProcessLabel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding Icon}" ContentTemplate="{StaticResource AppIconTemplate}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProcessText" Text="{Binding ProcessLabel}" FontSize="10.5"
                                   Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border x:Name="PlayingBadge" Grid.Column="2" CornerRadius="6" Padding="6,1" Visibility="Collapsed"
                            Background="{StaticResource SuccessSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="Playing" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="PlayingBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProcessLabel}" Value="{x:Null}">
                    <Setter TargetName="ProcessText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Section caption, hidden when its list is empty (Tag = the list) -->
        <Style x:Key="SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="10,8,8,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.HasItems, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="OpenButton" Style="{StaticResource SmallIconButton}" Click="OpenButton_Click"
                ToolTip="Add an app to this channel"
                AutomationProperties.AutomationId="AddAppButton" AutomationProperties.Name="Add app">
            <Path Data="M11,5H13V11H19V13H13V19H11V13H5V11H11V5Z" Fill="{StaticResource TextBrush}" Width="12" Height="12" Stretch="Uniform" />
        </Button>

        <Popup x:Name="DropDown" PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom" HorizontalOffset="-264"
               VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Opened="DropDown_Opened" Closed="DropDown_Closed">
            <Border Width="292" MaxHeight="440" Padding="6" CornerRadius="12" BorderThickness="1"
                    Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderHoverBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox" Margin="2,2,2,4" Style="{StaticResource DarkTextBox}"
                             Tag="Search apps, or type a process name" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                             AutomationProperties.AutomationId="AddAppSearch" AutomationProperties.Name="Search apps" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="RUNNING" Style="{StaticResource SectionCaption}" Tag="{Binding ElementName=RunningList}" />
                            <ItemsControl x:Name="RunningList" ItemTemplate="{StaticResource AppItemTemplate}" Focusable="False" />

                            <TextBlock Text="INSTALLED" Style="{StaticResource SectionCaption}" Tag="{Binding ElementName=InstalledList}" />
                            <ItemsControl x:Name="InstalledList" ItemTemplate="{StaticResource AppItemTemplate}" Focusable="False" />

                            <TextBlock x:Name="NoMatch" Margin="10,8,10,8" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                                       Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
