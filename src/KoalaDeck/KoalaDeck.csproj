<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used for the System Tray icon (NotifyIcon + ContextMenuStrip). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KoalaDeck</RootNamespace>
    <AssemblyName>KoalaDeck</AssemblyName>
    <ApplicationIcon>Assets\KoalaDeck.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Koala Deck</Product>
    <AssemblyTitle>Koala Deck</AssemblyTitle>
    <Description>Companion app for the Koala Deck ESP32 USB audio controller</Description>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003 targets WinForms-first apps; this is a WPF app, which reads its DPI mode from app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KoalaDeck.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WPF types unambiguous (Application, MessageBox, Color, Brush, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\KoalaDeck.ico" />
  </ItemGroup>

</Project>
