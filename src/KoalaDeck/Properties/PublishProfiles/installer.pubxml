<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer payload: a regular self-contained app folder (KoalaDeck.exe + runtime DLLs). Nothing is extracted at
  start-up and the target PC needs no .NET install. installer\KoalaDeck.iss packs this folder.

  dotnet publish src/KoalaDeck -p:PublishProfile=installer
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\installer\</PublishDir>
  </PropertyGroup>
</Project>
