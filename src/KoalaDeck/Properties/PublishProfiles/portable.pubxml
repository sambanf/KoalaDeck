<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable build: one self-contained, compressed KoalaDeck.exe that runs from anywhere (the .NET 10 runtime is
  bundled, so the target PC needs nothing installed). The installer uses the "installer" profile instead.

  dotnet publish src/KoalaDeck -p:PublishProfile=portable
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native DLLs go inside the exe too (extracted once to %TEMP%\.net on first start). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\portable\</PublishDir>
  </PropertyGroup>
</Project>
