<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build for distribution: one self-contained, compressed KoalaDeck.exe (the .NET 10 runtime is bundled,
  so the target PC needs nothing installed). Used as the portable app and as the payload of the installer.

  dotnet publish src/KoalaDeck -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native DLLs go inside the exe too (extracted once to %TEMP%\.net on first start). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
