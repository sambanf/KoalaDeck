<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette (dark) -->
    <Color x:Key="BgColor">#0B0D12</Color>
    <Color x:Key="SurfaceColor">#141821</Color>
    <Color x:Key="Surface2Color">#1B202B</Color>
    <Color x:Key="Surface3Color">#262C3A</Color>
    <Color x:Key="BorderColor">#252B39</Color>
    <Color x:Key="BorderHoverColor">#363E51</Color>
    <Color x:Key="TextColor">#E8ECF4</Color>
    <Color x:Key="TextMutedColor">#8B94A7</Color>
    <Color x:Key="TextDimColor">#5A6275</Color>
    <Color x:Key="AccentColor">#4F8CFF</Color>
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="SimulatorColor">#C084FC</Color>

    <!-- Per-channel accents -->
    <Color x:Key="Channel1Color">#38BDF8</Color>
    <Color x:Key="Channel2Color">#7C83FF</Color>
    <Color x:Key="Channel3Color">#1ED760</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#264F8CFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2622C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26EF4444" />
    <SolidColorBrush x:Key="SimulatorBrush" Color="{StaticResource SimulatorColor}" />
    <SolidColorBrush x:Key="SimulatorSoftBrush" Color="#26C084FC" />

    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#171B25" />
        <GradientStop Offset="1" Color="#12151D" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#232A3A" />
        <GradientStop Offset="1" Color="#151922" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
